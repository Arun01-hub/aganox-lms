<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aganox Identity Server — secure sign-in and authorization for Aganox applications." />
    <title>@ViewData["Title"] - Aganox Identity</title>
    <link rel="stylesheet" href="~/css/identity-enterprise/identity-enterprise.css" asp-append-version="true" />
</head>
<body class="identity-shell">
    <header class="identity-shell__header">
        <a href="/" class="identity-shell__brand">
            <span class="identity-shell__logo" aria-hidden="true">A</span>
            <span>Aganox Identity</span>
        </a>
        <span class="identity-shell__tagline">Secure authentication for Aganox applications</span>
    </header>
    <main class="identity-shell__main">
        @RenderBody()
    </main>
    <footer class="identity-shell__footer">
        <p>&copy; @DateTime.UtcNow.Year Aganox. All rights reserved.</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
