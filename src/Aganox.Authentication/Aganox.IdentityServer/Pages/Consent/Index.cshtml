@page
@model Aganox.IdentityServer.Pages.Consent.IndexModel
@{
    ViewData["Title"] = "Authorize application";
}

<section class="card card--wide" aria-labelledby="consent-heading">
    <div class="card__brand">
        <span class="card__logo" aria-hidden="true">A</span>
        <h1 id="consent-heading" class="card__title">Authorize @Model.ApplicationName</h1>
    </div>
    <p class="card__lead">This application is requesting access to your account with the following permissions:</p>

    <ul class="scope-list" aria-label="Requested permissions">
        @foreach (var scope in Model.Scopes)
        {
            <li class="scope-list__item">@scope</li>
        }
    </ul>

    <form method="post" action="/connect/authorize" class="form">
        @Html.AntiForgeryToken()
        @foreach (var parameter in HttpContext.Request.Query)
        {
            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
        }
        <div class="form__actions form__actions--row">
            <button type="submit" name="submit.Accept" value="accept" class="btn btn--primary btn--lg">Accept</button>
            <button type="submit" name="submit.Deny" value="deny" class="btn btn--danger btn--lg">Deny</button>
        </div>
    </form>
</section>
