## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg

# Node / Angular
node_modules/
.angular/
dist/
npm-debug.log*

# IDE
.vs/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Secrets / local
appsettings.*.local.json
*.pfx
.env
.env.*

# Installer prerequisites (downloaded at build time)
src/installer/prerequisites/SqlLocalDB.msi
src/installer/prerequisites/vc_redist.x64.exe

# Generated SPA output (created by publish-win.ps1)
src/backend/Aganox.Lms.Api/wwwroot/

# Test / temp
TestResults/
scripts/login-response.json

# Ignore local SQLite database
*.db
*.db-shm
*.db-wal
**/bin/
**/obj/
*.user
.vs/
**/node_modules/
**/dist/
