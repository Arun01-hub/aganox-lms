{
  "$schema": "./apps.schema.json",
  "defaults": {
    "dotnetConfiguration": "Debug",
    "dotnetLaunchProfile": "https",
    "npmInstallOnBuild": true,
    "startupDelaySeconds": 3
  },
  "applications": [
    {
      "id": "identity-server",
      "name": "Aganox Identity Server",
      "description": "OpenIddict-based authentication server for all Aganox products",
      "type": "dotnet",
      "enabled": true,
      "path": "src/Aganox.Authentication/Aganox.IdentityServer",
      "dependsOn": [],
      "urls": [
        "https://localhost:7036",
        "http://localhost:5110"
      ],
      "build": {
        "configuration": "Debug"
      },
      "run": {
        "launchProfile": "https"
      }
    },
    {
      "id": "rental-web",
      "name": "Aganox Rental Web",
      "description": "Angular SPA for the Rental product",
      "type": "npm",
      "enabled": true,
      "path": "src/Aganox.Rental/aganox-rental-web",
      "dependsOn": [
        "identity-server",
        "rental-api"
      ],
      "urls": [
        "http://rental.aganox.local:4200"
      ],
      "build": {
        "script": "build"
      },
      "run": {
        "script": "start"
      }
    },
    {
      "id": "rental-api",
      "name": "Aganox Rental WebAPI",
      "description": "Property rental microservice backend for the Rental SPA",
      "type": "dotnet",
      "enabled": true,
      "path": "src/Aganox.Rental/Aganox.Rental.WebAPI",
      "dependsOn": [
        "identity-server"
      ],
      "urls": [
        "https://localhost:7241",
        "http://localhost:5241"
      ],
      "build": {
        "configuration": "Debug"
      },
      "run": {
        "launchProfile": "https"
      }
    }
  ]
}
