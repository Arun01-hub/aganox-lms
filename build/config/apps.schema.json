{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aganox Applications",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "object",
      "properties": {
        "dotnetConfiguration": { "type": "string" },
        "dotnetLaunchProfile": { "type": "string" },
        "npmInstallOnBuild": { "type": "boolean" },
        "startupDelaySeconds": { "type": "number" }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "id", "name", "type", "path" ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [ "dotnet", "npm", "script" ]
          },
          "enabled": { "type": "boolean" },
          "path": { "type": "string" },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "urls": {
            "type": "array",
            "items": { "type": "string" }
          },
          "build": { "type": "object" },
          "run": { "type": "object" },
          "hooks": {
            "type": "object",
            "properties": {
              "preBuild": { "type": "string" },
              "postBuild": { "type": "string" },
              "preRun": { "type": "string" },
              "postRun": { "type": "string" }
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
